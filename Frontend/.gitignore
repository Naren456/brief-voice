# Frontend-local ignores. The root .gitignore also covers these paths.

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output and caches
dist/
dist-ssr/
build/
.vite/
.vite-cache/
.cache/
.turbo/
.parcel-cache/
*.tsbuildinfo
*.eslintcache

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Test output
coverage/
*.lcov
